{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://know-os.local/schemas/caderno.track.v1.schema.json",
  "title": "Caderno Track Pack v1 — draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packId",
    "version",
    "track"
  ],
  "properties": {
    "schema": {
      "const": "caderno.track.v1"
    },
    "packId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "language": {
      "type": "string",
      "default": "pt-BR"
    },
    "track": {
      "$ref": "#/$defs/track"
    }
  },
  "$defs": {
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "modules"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/module"
          }
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "lessons"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "lessons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lesson"
          }
        }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "title",
        "concepts",
        "blocks",
        "activities"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "concepts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/concept"
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activity"
          }
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "text",
            "concept",
            "note",
            "warning",
            "code",
            "example",
            "prediction",
            "summary"
          ]
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "type",
        "conceptIds",
        "prompt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "prediction",
            "multiple-choice",
            "explain",
            "code",
            "debug"
          ]
        },
        "conceptIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "prompt": {
          "type": "string"
        }
      }
    }
  }
}
